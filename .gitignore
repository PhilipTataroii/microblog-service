# не добавляю виртуальное окружение в Git
.venv/

# не добавляю кэш Python
__pycache__/
*.pyc

# не добавляю .env, потому что там могут находиться пароли
.env

# не добавляю временные файлы pytest
.pytest_cache/

# не добавляю результаты проверки покрытия тестами
.coverage
htmlcov/

# не добавляю настройки PyCharm
.idea/

# не добавляю локальные загруженные изображения
uploads/

# не добавляю тестовую картинку
test.jpg
